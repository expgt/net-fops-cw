global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporters'
    static_configs:
      - targets:
{% for host in groups['all'] %}
{% if host != 'prometheus' %}
        - '{{ hostvars[host]["ansible_host"] | default(host) }}:9100'
{% endif %}
{% endfor %}

  - job_name: 'nginx-log-exporters'
    static_configs:
      - targets:
{% for host in groups['all'] %}
{% if host != 'prometheus' %}
        - '{{ hostvars[host]["ansible_host"] | default(host) }}:4040'
{% endif %}
{% endfor %}

remote_write:
  - url: "http://telegraf:9201/write"