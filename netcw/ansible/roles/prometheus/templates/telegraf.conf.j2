[agent]
  interval = "15s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "15s"
  flush_jitter = "0s"

[[inputs.prometheus_remote_write]]
  address = ":9201"
  path = "/write"

[[outputs.postgresql]]
  connection = "host=${PG_HOST} user=${PG_USER} password=${PG_PASSWORD} dbname=${PG_DATABASE} port=${PG_PORT} sslmode=verify-full"
  
  create_templates = true