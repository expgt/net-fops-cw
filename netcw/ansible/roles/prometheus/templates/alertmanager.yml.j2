global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'cluster']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 3h
  receiver: 'telegram-notifications'

receivers:
  - name: 'telegram-notifications'
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: {{ telegram_chat_id | int }}
        message: |
          {% raw %}{{- if eq .Status "firing" }}🔥 <b>КРИТИЧЕСКИЙ АЛЕРТ</b> {{- else }}✅ <b>ИСПРАВЛЕНО</b> {{- end }}
          <b>Название:</b> {{ .CommonAnnotations.summary }}
          <b>Описание:</b> {{ .CommonAnnotations.description }}
          <b>Активные алерты:</b>
          {{- range .Alerts }}
            • <b>Узел:</b> {{ .Labels.instance }} ({{ .Labels.severity }})
          {{- end }}
          {% endraw %}
        parse_mode: 'HTML'